+def find_struct_member_matching(obj, member_name, predicate):
+    """Recursively find a member stored under member_name (or one of the
+    __dup suffixed spellings preserve_duplicate_json_keys produces) whose
+    value satisfies predicate.
 
+    libstdc++ repeats _M_head_impl once per tuple element, so an exact-match
+    lookup can return the wrong leaf; the predicate picks the intended one.
+    """
+    if not obj:
+        return None
+
+    if obj.get('kind') == 'heap_block' or obj.get('kind') == 'array':
+        for val in obj.get('val') or []:
+            found = find_struct_member_matching(val, member_name, predicate)
+            if found is not None:
+                return found
+        return None
+
+    if obj.get('kind') != 'struct':
+        return None
+
+    members = obj.get('val') or {}
+    for key in sorted(members.keys()):
+        if key == member_name or key.startswith(member_name + '__dup'):
+            member = members[key]
+            if member and predicate(member):
+                return member
+
+    for key in sorted(members.keys()):
+        found = find_struct_member_matching(members[key], member_name, predicate)
+        if found is not None:
+            return found
+
+    return None
+
