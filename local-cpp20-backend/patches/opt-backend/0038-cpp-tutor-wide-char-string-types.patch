+def get_wide_string_summary(obj, heap):
+    """Summarize std::wstring / u8string / u16string / u32string.
+
+    Their character buffers are deliberately left undecoded: the elements are
+    wider than one byte, and Valgrind emits no payload for them. Rendering
+    `data` and `size` still beats falling through to raw _M_dataplus /
+    _M_string_length / _M_local_buf internals.
+    """
+    if obj.get('kind') != 'struct':
+        return None
+
+    char_type = get_string_char_type(obj.get('type') or '', 'basic_string')
+    if char_type is None or char_type == 'char':
+        return None
+    display_type = STRING_CHAR_TYPE_NAMES.get(char_type)
+    if display_type is None:
+        return None
+
+    members = obj.get('val') or {}
+    ret = ['C_STRUCT', obj['addr'], display_type]
+
+    dataplus = members.get('_M_dataplus')
+    if dataplus and dataplus.get('kind') == 'struct':
+        ptr = (dataplus.get('val') or {}).get('_M_p')
+        if ptr is not None:
+            ret.append(['data', encode_value(ptr, heap)])
+
+    length = members.get('_M_string_length')
+    if length is not None:
+        ret.append(['size', encode_value(length, heap)])
+
+    if len(ret) == 3:
+        return None
+    return ret
+
