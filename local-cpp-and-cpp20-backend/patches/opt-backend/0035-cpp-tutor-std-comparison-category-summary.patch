+# libstdc++ stores a comparison category as a single signed char holding -1
+# (less), 0 (equal/equivalent), 1 (greater), or 2 (partial_ordering's
+# unordered). Negative values arrive as escaped unsigned bytes.
+CPP_COMPARISON_CATEGORY_NAMES = {
+    'strong_ordering': {0xff: 'less', 0: 'equal', 1: 'greater'},
+    'weak_ordering': {0xff: 'less', 0: 'equivalent', 1: 'greater'},
+    'partial_ordering': {0xff: 'less', 0: 'equivalent', 1: 'greater',
+                         2: 'unordered'},
+}
+
+
+def get_std_comparison_category_summary(obj, heap):
+    if obj.get('kind') != 'struct':
+        return None
+
+    type_name = display_cpp_type(obj.get('type') or '')
+    if type_name.startswith('std::'):
+        base_name = type_name[len('std::'):]
+    else:
+        base_name = type_name
+
+    value_names = CPP_COMPARISON_CATEGORY_NAMES.get(base_name)
+    if value_names is None:
+        return None
+
+    value = get_direct_struct_member(obj, '_M_value')
+    if value is None or value.get('kind') != 'base':
+        return None
+
+    raw_value = value.get('val')
+    byte = decode_trace_char_byte(raw_value)
+    if byte is None:
+        # keeps <UNINITIALIZED> and any unexpected payload visible
+        display_value = raw_value
+    else:
+        display_value = value_names.get(byte, byte)
+
+    return [
+        'C_STRUCT',
+        obj['addr'],
+        'std::' + base_name,
+        ['value', ['C_DATA', value.get('addr', obj['addr']), 'type',
+                   display_value]]
     ]
 
 
