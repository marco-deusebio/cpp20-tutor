+# inverse of the Valgrind-side char emitter: turns one displayed char token back
+# into its raw byte value, or None when the token is not a single byte
+def decode_trace_char_byte(value):
+    if isinstance(value, (int, long)):
+        if 0 <= value <= 0xff:
+            return value
+        return None
+
+    if not isinstance(value, basestring):
+        return None
+
+    named_escapes = {'\\0': 0, '\\n': 0x0a, '\\r': 0x0d, '\\t': 0x09}
+    if value in named_escapes:
+        return named_escapes[value]
+
+    if len(value) == 6 and value.startswith('\\u'):
+        try:
+            return int(value[2:], 16)
+        except ValueError:
+            return None
+
+    if len(value) == 1:
+        return ord(value)
+
+    return None
 
 
