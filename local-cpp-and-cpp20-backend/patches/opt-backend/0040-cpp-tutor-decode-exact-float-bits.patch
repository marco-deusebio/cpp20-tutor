+# Valgrind emits floats as a tagged IEEE-754 bit pattern (see the Valgrind
+# side 0017 patch) because its own %f truncates at six decimals and mangles
+# very large magnitudes, infinities, and NaN. JSON has no literal for the
+# non-finite values, so they become readable strings instead.
+NON_FINITE_TRACE_FLOATS = {
+    'nan': 'NaN',
+    'inf': 'Infinity',
+    '-inf': '-Infinity',
+}
+
+
+def decode_trace_float_value(val):
+    """Turn an 'f32:xxxxxxxx' / 'f64:xxxxxxxxxxxxxxxx' payload into a Python
+    float, or into a readable string for NaN and the infinities. Returns the
+    input unchanged when it is not a tagged float."""
+    if not isinstance(val, basestring):
+        return val
+
+    if val.startswith('f32:'):
+        fmt, width = '>f', 8
+    elif val.startswith('f64:'):
+        fmt, width = '>d', 16
+    else:
+        return val
 
+    digits = val[4:]
+    if len(digits) != width:
+        return val
+    try:
+        raw = binascii.unhexlify(digits)
+    except (TypeError, binascii.Error):
+        return val
 
+    try:
+        decoded = struct.unpack(fmt, raw)[0]
+    except struct.error:
+        return val
+
+    # repr() round-trips NaN/inf as 'nan'/'inf'/'-inf' on Python 2
+    text = repr(decoded)
+    if text in NON_FINITE_TRACE_FLOATS:
+        return NON_FINITE_TRACE_FLOATS[text]
+    return decoded
+
