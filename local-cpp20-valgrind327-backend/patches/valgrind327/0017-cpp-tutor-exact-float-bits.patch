--- a/coregrind/m_debuginfo/debuginfo.c
+++ b/coregrind/m_debuginfo/debuginfo.c
@@ -4532,6 +4532,26 @@
    if (ent->Te.TyBase.enc != 'S' || ent->Te.TyBase.szB != sizeof(char))
       return NULL;
    return ent;
+}
+
+/* Valgrind's own printf has only a minimal %f: it truncates at six decimals,
+   produces nothing parseable for very large magnitudes or infinities, and
+   renders NaN as a huge integer. Emit the raw IEEE-754 bit pattern instead and
+   let the postprocessor reconstruct the exact value. */
+static void pg_emit_json_float_bits(VgFile* trace_fp, Addr data_addr,
+                                    SizeT szB)
+{
+   if (szB == sizeof(float)) {
+      UInt bits;
+      VG_(memcpy)(&bits, (void*)data_addr, sizeof(bits));
+      VG_(fprintf)(trace_fp, "\"f32:%08x\"", bits);
+   } else if (szB == sizeof(double)) {
+      ULong bits;
+      VG_(memcpy)(&bits, (void*)data_addr, sizeof(bits));
+      VG_(fprintf)(trace_fp, "\"f64:%016llx\"", bits);
+   } else {
+      VG_(fprintf)(trace_fp, "\"<UNSUPPORTED>\"");
+   }
 }
 
